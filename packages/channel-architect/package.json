{
  "name": "@open-mercato/channel-architect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "description": "Partner program design and governed versioning for Open Mercato.",
  "scripts": {
    "build": "node build.mjs"
  },
  "exports": {
    ".": "./dist/index.js",
    "./*": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "./*/*": {
      "types": ["./src/*/*.ts", "./src/*/*.tsx"],
      "default": "./dist/*/*.js"
    },
    "./*/*/*": {
      "types": ["./src/*/*/*.ts", "./src/*/*/*.tsx"],
      "default": "./dist/*/*/*.js"
    },
    "./*/*/*/*": {
      "types": ["./src/*/*/*/*.ts", "./src/*/*/*/*.tsx"],
      "default": "./dist/*/*/*/*.js"
    },
    "./*/*/*/*/*": {
      "types": ["./src/*/*/*/*/*.ts", "./src/*/*/*/*/*.tsx"],
      "default": "./dist/*/*/*/*/*.js"
    }
  },
  "peerDependencies": {
    "@mikro-orm/core": "^7.0.0",
    "@mikro-orm/decorators": "^7.0.0",
    "@mikro-orm/postgresql": "^7.0.0",
    "@open-mercato/core": ">=0.6.0 <0.7.0",
    "@open-mercato/shared": ">=0.6.0 <0.7.0",
    "@open-mercato/ui": ">=0.6.0 <0.7.0",
    "next": ">=16.0.0 <17.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
